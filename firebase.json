{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/data/**",
      "**/python_scripts/**",
      "**/src/**",
      "**/venv/**",
      "*.iml",
      "package.json",
      "package-lock.json",
      "webpack.config.js"
    ],
      "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
